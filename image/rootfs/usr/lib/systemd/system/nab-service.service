[Unit]
Description=Nabaztag service (HTTP :8080, settings, updates)
Wants=mosquitto.service user@1000.service
After=mosquitto.service user@1000.service

[Service]
Type=exec
User=pynab
Group=pynab
Environment=XDG_RUNTIME_DIR=/run/user/1000
# PYNAB_VERSION, PYNAB_UPDATE_REPO, PYNAB_UPDATE_ASSET and, on ARMv6, an empty PYNAB_LVA_UNIT.
EnvironmentFile=/etc/pynab/release.env
ExecStart=/usr/bin/nab-service
Restart=always
RestartSec=2
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/data/pynab

[Install]
WantedBy=multi-user.target
