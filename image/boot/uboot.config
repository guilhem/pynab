# Merged into rpi_0_w_defconfig / rpi_arm64_defconfig by image/prepare.sh.
# Redundant raw environment in the gap before the first partition; offsets and
# size must match image/genimage.cfg and /etc/fw_env.config.
# CONFIG_ENV_IS_IN_FAT is not set
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_REDUNDANT=y
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_OFFSET=0x100000
CONFIG_ENV_OFFSET_REDUND=0x200000
CONFIG_ENV_MMC_DEVICE_INDEX=0
# Headless: boot at once, and never stop at a prompt because of UART noise.
CONFIG_BOOTDELAY=-2
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="load mmc 0:1 ${scriptaddr} boot.scr && source ${scriptaddr}"
CONFIG_OF_LIBFDT_OVERLAY=y
CONFIG_CMD_SETEXPR=y
# RAUC installs root filesystems; no UEFI capsule generator is needed on the host.
# CONFIG_TOOLS_MKEFICAPSULE is not set
