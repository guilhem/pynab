[Unit]
Description=Nabaztag core (LEDs, ears, button, RFID, audio)
Wants=mosquitto.service user@1000.service
After=mosquitto.service user@1000.service pynab-rfid.service tagtagtag-mixerd.service

[Service]
Type=exec
User=pynab
Group=pynab
# rpi_ws281x drives PWM+DMA through /dev/mem (kmem, see 60-pynab.rules) and
# /dev/vcio (video): root-equivalent access, confined to this unit.
SupplementaryGroups=gpio video kmem audio
AmbientCapabilities=CAP_SYS_RAWIO
CapabilityBoundingSet=CAP_SYS_RAWIO
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/nab-core
Restart=always
RestartSec=2
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/data/pynab

[Install]
WantedBy=multi-user.target
